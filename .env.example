# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL="postgresql://nexvo:nexvo_dev_only@localhost:5432/nexvo_dev"
# Used by integration/e2e tests. Must point at a disposable database.
TEST_DATABASE_URL="postgresql://nexvo:nexvo_dev_only@localhost:5432/nexvo_test"
# Shared secret used to verify payment-provider webhook signatures (HMAC-SHA256).
PAYMENT_WEBHOOK_SECRET="replace-with-a-long-random-value"
# Directory where uploaded evidence files are stored in development.
# Production should use an object store behind the same StorageProvider interface.
UPLOAD_DIR="./.data/uploads"
APP_URL="http://localhost:3000"

# Optional: online payment via Chargily Pay V2 (CIB/Edahabia). Leave empty to disable.
# Use a TEST key in development. CHARGILY_MODE=live needs owner approval and an https APP_URL.
CHARGILY_SECRET_KEY=""
CHARGILY_MODE="test"
# Optional: AI suggestions (civic triage, operations brief). Leave empty to disable.
ANTHROPIC_API_KEY=""
# Required: 32 random bytes, base64, for secrets at rest (2FA secrets, organizations' payment keys).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes stored 2FA secrets and payment keys unreadable.
APP_ENCRYPTION_KEY=""
